<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Alarms / exact reminders.

         USE_EXACT_ALARM, not a runtime grant flow: from Android 14 (API 34)
         SCHEDULE_EXACT_ALARM is no longer granted at install to an app
         targeting 34+, and nothing in this app ever asked for it, so every
         reminder silently fell through to AlarmScheduler's inexact,
         Doze-batched branch on a fresh install. USE_EXACT_ALARM is the
         platform's own answer for an app whose core function *is* reminders;
         it is granted at install with no user interaction, and
         canScheduleExactAlarms() reports true while it is held, so
         AlarmScheduler needs no change. The Play policy that normally makes
         this permission awkward to justify does not apply to an app that is
         sideloaded and never reaches a store. SCHEDULE_EXACT_ALARM is kept
         capped at API 32, where it is still the install-time permission that
         covers this. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Alarm-tier reminders vibrate until answered, the way a clock alarm
         does (AlarmActivity, and the Alarm channel's own pattern). A normal
         permission, granted at install; see §7 R59 for why it was missing. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is declared since §7 R83, by
         the owner's decision: the app asks for everything reminders depend
         on, and this one lets the battery exemption be granted with one tap
         in the system's own dialog instead of a search through the list.
         R39 to R82 kept it removed on least-privilege grounds; that reasoning
         holds for a store app and the owner chose against it for this one,
         which is sideloaded. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
         WAKE_LOCK was previously described here as removed too. Deleting
         its <uses-permission> line only removed it from THIS file - the
         manifest merger put it straight back from androidx.work, which
         arrives transitively via androidx.glance:glance-appwidget. It is now
         genuinely removed, below, via tools:node="remove": no receiver
         acquires a PowerManager.WakeLock, an alarm-fired broadcast already
         gets the OS's own brief wake guarantee for onReceive(), and every
         receiver extends that with goAsync() for its coroutine work.
         FOREGROUND_SERVICE was removed the same way until SPEC.md section 7
         R80: AlarmRingService (below) is this app's one foreground service,
         of type mediaPlayback, and it is what lets an Alarm-tier reminder
         ring until it is answered while the phone is unlocked.

         ACCESS_NETWORK_STATE arrives the same way, into an app that
         deliberately declares no INTERNET permission at all.
         USE_FINGERPRINT arrives from androidx.biometric:1.1.0 and has been
         deprecated since API 28 - dead at this app's minSdk 30, which uses
         BIOMETRIC_STRONG via USE_BIOMETRIC instead.

         If a home-screen widget ever stops updating, this block is the first
         place to look: Glance's session manager is the real WorkManager
         consumer here. Restore whichever line it turns out to need and
         correct this comment rather than reverting the whole block.
         Re-check with :app:processReleaseMainManifest and read
         app/build/intermediates/merged_manifest/release/. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <!-- Location-based snooze re-notify: removed for now. Nothing in the
         codebase implements this yet (no LocationManager/FusedLocationProvider
         usage anywhere), and ACCESS_BACKGROUND_LOCATION is one of the most
         sensitive permissions Android has - least-privilege (PERM-001) says
         don't declare it until the feature exists. When it's actually built,
         request ACCESS_COARSE_LOCATION or ACCESS_FINE_LOCATION first, and only
         request ACCESS_BACKGROUND_LOCATION afterward, in a separate step
         (PERM-027) - never all three in the same batch. -->

    <!-- Biometric app-lock (optional toggle) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- No android.permission.INTERNET anywhere in this file, by design. -->

    <!-- Package-visibility (Android 11+): without this, the zxing SCAN intent
         resolves as "no app can handle this" even when a scanner like Binary
         Eye is installed, since queryIntentActivities() is filtered by default.
         Doesn't declare the scanner app itself, just the intent action it's
         checked against. -->
    <queries>
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
        <!-- The OEM auto-start pages AutoStartSettings resolves (§9 #29, HM-36). -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.asus.mobilemanager" />
    </queries>

    <!-- dataExtractionRules and fullBackupContent below are inert while
         allowBackup is false: nothing reads either file. They are kept rather
         than deleted on purpose. Both describe what would be safe to copy if
         backup were ever switched on, and re-deriving that from scratch under
         time pressure is how an encrypted database ends up in a cloud backup.
         An unused rule that is correct costs nothing; a missing one costs a
         decision nobody will make carefully. See §7 R58. -->
    <application
        android:name=".EmivitaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Emivita"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Emivita">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen target for ALARM-priority reminders. Not exported;
             only ever launched by this app's own notification / full-screen
             intent. singleTask so a second alarm firing while one is already
             showing brings the same instance forward instead of stacking. -->
        <activity
            android:name=".feature.alarm.AlarmActivity"
            android:exported="false"
            android:theme="@style/Theme.Emivita.Main"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- "Snooze for how long?" is a dialog-themed activity a notification
             action can open, since an action cannot show a dialog itself (§9
             #25). Not exported; only this app's PendingIntents launch it. -->
        <activity
            android:name=".feature.alarm.SnoozePickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Emivita.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <!-- Fired by AlarmManager (see core/scheduling/AlarmScheduler.kt). -->
        <!-- The Alarm tier's ringing (SPEC.md section 7 R80): a foreground
             service whose notification is the reminder's own. -->
        <service
            android:name=".core.alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".core.scheduling.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Handles Take / Skip / Snooze from a reminder notification. -->
        <receiver
            android:name=".core.scheduling.ReminderActionReceiver"
            android:exported="false" />

        <!-- Handles Refill from a LowStockAlert notification (spec §9 item 8). -->
        <receiver
            android:name=".core.scheduling.AlertActionReceiver"
            android:exported="false" />

        <!-- AlarmManager forgets every exact alarm across a reboot; some OEM
             skins behave similarly across an app update. exported="true" is
             intentional, not an oversight: BOOT_COMPLETED is a protected
             broadcast (RECEIVE_BOOT_COMPLETED is only ever held by the
             system), so no third-party app can forge it regardless of this
             flag, and there are credible real-world reports of
             exported="false" silently failing to deliver it on Android 12+
             despite the flag theoretically being irrelevant for protected
             broadcasts.

             VERIFIED on device (2026-09-04, OnePlus 9 Pro LE2123, OxygenOS /
             Android 14): after a real reboot, with the app never opened, the
             alarm armed before the reboot was present again in `dumpsys
             alarm` and the app process had been started by the boot
             broadcast. BOOT_COMPLETED is delivered to this receiver at
             exported="true" on an OEM skin, which is exactly what could not
             be settled by reading code.

             Left at "true". The untested half is whether "false" would be
             delivered here too, and it is not worth a second reboot: the
             least-privilege gain is nil either way, since both filtered
             actions are protected broadcasts no third-party app can send and
             onReceive() rejects any other action before touching the
             container. -->
        <receiver
            android:name=".core.scheduling.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Clock or zone changed: every armed instant was computed in the old
             zone, so re-arm from now (§7 R60). Both actions are system-only
             broadcasts; TIMEZONE_CHANGED is on the implicit-broadcast exception
             list, and medTimer declares the pair the same way. -->
        <receiver
            android:name=".core.scheduling.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Language changed: channel names and descriptions follow it (§9 #25).
             LOCALE_CHANGED is on the implicit-broadcast exception list. -->
        <receiver
            android:name=".core.notification.LocaleChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (spec §9 #7, Glance-based; see
             feature/widget/NextRemindersWidget.kt and StockLevelsWidget.kt). -->
        <receiver
            android:name=".feature.widget.NextRemindersWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_next_reminders_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_reminders_widget_info" />
        </receiver>

        <receiver
            android:name=".feature.widget.StockLevelsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_stock_levels_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_levels_widget_info" />
        </receiver>

        <!-- androidx.compose.ui.tooling.PreviewActivity, removed from BOTH
             variants.

             Every component this app declares is exported="false" except the
             LAUNCHER activity, and the data those components sit on is a
             SQLCipher database whose key is wrapped by a non-exportable
             AndroidKeyStore key. This one arrived exported="true", with no
             android:permission, from androidx.compose.ui:ui-tooling, which
             reaches the merged manifest twice: once from the
             debugImplementation on it, and once transitively as an ordinary
             (not debug-scoped) dependency of com.kizitonwose.calendar:compose,
             which is why it was on releaseRuntimeClasspath too. The build file
             now excludes that second copy; this removes the component itself.

             Release was never the exposure: PreviewActivity's own onCreate
             checks FLAG_DEBUGGABLE and finishes when it is unset, so there it
             was dead weight. Debug is. It is built and installed on the same
             device (see buildTypes.release's note on the shared signing
             identity, which exists so the two install over each other),
             android:debuggable is true there, and past that guard the activity
             reads two intent string extras and reflectively loads and renders
             the class they name, inside the process holding the unlocked
             database handle. Any app on the device could start it.

             The cost is Android Studio's "Deploy Preview to Device", which is
             what launches this activity. The IDE's own preview pane does not
             use it and is unaffected, as is the @Preview annotation and
             everything else ui-tooling provides. If deploy-to-device is ever
             wanted back, move this node to a src/release/AndroidManifest.xml:
             that keeps the component out of the shipped variant while
             restoring it in debug, and re-accepts the exposure above
             knowingly rather than by omission. -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />

    </application>
</manifest>
