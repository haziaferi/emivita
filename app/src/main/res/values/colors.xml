<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The splash ground is the launcher icon's own tile (SPEC 7 R98, the
         owner's choice), so the tile disappears into it; values-night has
         the dark splash's near-black. The window shows this colour from the
         splash until Compose's first frame, which repaints with the user's
         palette. -->
    <color name="splash_background">@color/ic_launcher_background</color>

    <!-- Adaptive icon background layer: a near-neutral grey chosen by
         colour-fitness scoring (SPEC 7 R92) to vanish against the light
         splash. It belongs to no palette, because the launcher icon cannot
         follow the one a user has active in the app. -->
    <color name="ic_launcher_background">#F3F4F6</color>
</resources>
